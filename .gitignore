__pycache__/
*.py[cod]
.venv/

# Superseded regressor kept locally as evidence for the split correction
# described in docs/METHOD.md. Not needed to run anything.
checkpoint/mic_regressor_leaky_split.json
checkpoint/mic_regressor_leaky_split_meta.json

# Model weights ship as GitHub Release assets, not in git. git-lfs is not
# usable here: the organizers' validator does a plain `git clone`, and without
# git-lfs installed -- or once LFS bandwidth is spent -- that yields pointer
# files and the entry point fails to load a model. scripts/fetch_weights.py
# downloads these and verifies them against checkpoint/SHA256SUMS, which IS
# committed, and generate.py calls it before loading anything.
checkpoint/masked_diffusion_best.pt
checkpoint/mic_regressor.json

# Working notes and run artifacts, not part of the submission.
handoff.md
logs/
run_a/
run_b/

# Harmonized activity table: rebuilt, not redistributed. It aggregates sources
# with differing and in places unconfirmed redistribution terms, including
# GPL-3.0 HemoPI-2 data, which cannot ship under this repository's MIT licence.
# data/processed/README.md carries the rebuild command, the upstream sources
# with retrieval dates, the expected row counts and a checksum of the table the
# shipped models were trained on.
data/processed/activity_harmonized.csv

submission/
